@model SIMS.Application.DTOs.CreateCourseDto

@{
    ViewData["Title"] = "Thêm Khóa học mới";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Khóa học</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-book-half" aria-hidden="true"></i> @ViewData["Title"]</h1>
        <p class="page-subtitle">Các trường có dấu <span class="text-danger fw-bold">*</span> là bắt buộc.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

            <fieldset class="form-section">
                <legend><i class="bi bi-journal-text" aria-hidden="true"></i> Thông tin môn học</legend>
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="Code" class="form-label">Mã môn học<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="Code" class="form-control" placeholder="VD: PRN211" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 col-lg-2 order-lg-last">
                        <label asp-for="Credits" class="form-label">Số tín chỉ<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="Credits" type="number" class="form-control" value="3" aria-describedby="CreditsHelp" />
                        <div id="CreditsHelp" class="form-text">Từ 1 đến 10.</div>
                        <span asp-validation-for="Credits" class="text-danger"></span>
                    </div>
                    <div class="col-lg-7">
                        <label asp-for="Title" class="form-label">Tên môn học<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Basic Cross-Platform App with .NET" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Mô tả môn học<span class="required" aria-hidden="true">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend><i class="bi bi-diagram-3" aria-hidden="true"></i> Khoa &amp; Phân công</legend>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="DepartmentId" class="form-label">Khoa<span class="required" aria-hidden="true">*</span></label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                            <option value="">-- Chọn Khoa --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AssignedFacultyId" class="form-label">Phân công Giảng viên <span class="fw-normal text-muted">(tùy chọn)</span></label>
                        <select asp-for="AssignedFacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- Chưa phân công --</option>
                        </select>
                        <span asp-validation-for="AssignedFacultyId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PrerequisiteCourseId" class="form-label">Môn học tiên quyết <span class="fw-normal text-muted">(tùy chọn)</span></label>
                        <select asp-for="PrerequisiteCourseId" class="form-select" asp-items="ViewBag.Prerequisites">
                            <option value="">-- Không có --</option>
                        </select>
                        <span asp-validation-for="PrerequisiteCourseId" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg" aria-hidden="true"></i> Hủy bỏ</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save" aria-hidden="true"></i> Lưu Môn học</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
