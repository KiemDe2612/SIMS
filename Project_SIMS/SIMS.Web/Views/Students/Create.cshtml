@model SIMS.Application.DTOs.CreateStudentDto

@{
    ViewData["Title"] = "Thêm Sinh viên mới";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Sinh viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-person-plus" aria-hidden="true"></i> @ViewData["Title"]</h1>
        <p class="page-subtitle">Các trường có dấu <span class="text-danger fw-bold">*</span> là bắt buộc.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

            <fieldset class="form-section">
                <legend><i class="bi bi-person-vcard" aria-hidden="true"></i> Tài khoản &amp; Khoa</legend>
                <p class="form-section-hint">Mã sinh viên dùng để tạo tài khoản đăng nhập.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StudentId" class="form-label">Mã Sinh viên<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="StudentId" class="form-control" placeholder="VD: SE12345" aria-describedby="StudentIdHelp" />
                        <div id="StudentIdHelp" class="form-text">Hệ thống sẽ tự động tạo tài khoản [MãSV]@@sims.com</div>
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label">Khoa</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                            <option value="">-- Chọn Khoa --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend><i class="bi bi-person" aria-hidden="true"></i> Thông tin cá nhân</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Họ &amp; Tên đệm<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="LastName" class="form-control" placeholder="VD: Nguyễn Văn" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">Tên<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="FirstName" class="form-control" placeholder="VD: An" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">Ngày sinh<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label">Địa chỉ<span class="required" aria-hidden="true">*</span></label>
                        <input asp-for="Address" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg" aria-hidden="true"></i> Hủy bỏ</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save" aria-hidden="true"></i> Lưu Sinh viên</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
