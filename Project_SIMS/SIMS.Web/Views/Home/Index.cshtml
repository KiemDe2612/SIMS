@{
    ViewData["Title"] = "Tổng quan";
    var isAdmin = User.IsInRole("Administrator");
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Tổng quan</h1>
        <p class="page-subtitle">Chào mừng đến với Hệ thống Quản lý Thông tin Sinh viên (SIMS).</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        @if (isAdmin)
        {
            <a class="card stat-card" asp-controller="Students" asp-action="Index">
                <span class="stat-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                <div>
                    <p class="stat-label">Tổng số sinh viên</p>
                    <p class="stat-value">@ViewBag.TotalStudents</p>
                    <span class="stat-link">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
            </a>
        }
        else
        {
            <div class="card stat-card">
                <span class="stat-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                <div>
                    <p class="stat-label">Tổng số sinh viên</p>
                    <p class="stat-value">@ViewBag.TotalStudents</p>
                </div>
            </div>
        }
    </div>

    <div class="col-sm-6 col-lg-4">
        @if (isAdmin)
        {
            <a class="card stat-card is-success" asp-controller="Courses" asp-action="Index">
                <span class="stat-icon" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></span>
                <div>
                    <p class="stat-label">Tổng số môn học</p>
                    <p class="stat-value">@ViewBag.TotalCourses</p>
                    <span class="stat-link">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
            </a>
        }
        else
        {
            <div class="card stat-card is-success">
                <span class="stat-icon" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></span>
                <div>
                    <p class="stat-label">Tổng số môn học</p>
                    <p class="stat-value">@ViewBag.TotalCourses</p>
                </div>
            </div>
        }
    </div>

    <div class="col-sm-6 col-lg-4">
        <div class="card stat-card is-warning">
            <span class="stat-icon" aria-hidden="true"><i class="bi bi-person-workspace"></i></span>
            <div>
                <p class="stat-label">Tổng số giảng viên</p>
                <p class="stat-value">@ViewBag.TotalFaculties</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h2 class="card-title"><i class="bi bi-pie-chart text-primary" aria-hidden="true"></i> Sinh viên theo Khoa</h2>
                <span class="status-badge is-neutral">Dữ liệu minh họa</span>
            </div>
            <div class="card-body">
                <div class="chart-box">
                    <canvas id="departmentChart" role="img" aria-label="Biểu đồ tròn: tỷ lệ sinh viên theo khoa (dữ liệu minh họa)"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h2 class="card-title"><i class="bi bi-clock-history text-primary" aria-hidden="true"></i> Đăng ký gần đây</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover table-stack">
                    <caption class="visually-hidden">Các lượt đăng ký học phần gần đây</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sinh viên</th>
                            <th scope="col">Môn học</th>
                            <th scope="col">Ngày</th>
                            <th scope="col">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="4" class="empty-state-cell">
                                <div class="empty-state">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    <h3>Chưa có lượt đăng ký gần đây</h3>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var canvas = document.getElementById('departmentChart');
        if (!canvas || typeof Chart === 'undefined') return;
        var styles = getComputedStyle(document.documentElement);
        var color = function (name) { return styles.getPropertyValue(name).trim(); };
        new Chart(canvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Kỹ thuật phần mềm', 'Trí tuệ nhân tạo', 'An toàn thông tin'],
                datasets: [{
                    data: [45, 25, 30],
                    backgroundColor: [color('--sims-primary'), color('--sims-success'), color('--sims-warning')],
                    borderColor: '#ffffff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: color('--sims-text'), boxWidth: 14 } }
                }
            }
        });
    });
</script>
}
