@model SIMS.Application.DTOs.MyProfileDto

@{
    ViewData["Title"] = "Hồ sơ cá nhân";

    // Chữ cái viết tắt hiển thị trong avatar (thay cho dịch vụ avatar bên ngoài)
    var nameParts = (Model.FullName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length switch
    {
        0 => "SV",
        1 => nameParts[0].Substring(0, 1),
        _ => nameParts[0].Substring(0, 1) + nameParts[^1].Substring(0, 1)
    };
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-person-badge" aria-hidden="true"></i> @ViewData["Title"]</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100 mb-0">
            <div class="card-body text-center">
                <span class="avatar-initials" aria-hidden="true">@initials.ToUpper()</span>
                <h2 class="h5 mb-1">@Model.FullName</h2>
                <p class="text-muted mb-3"><i class="bi bi-mortarboard-fill text-primary" aria-hidden="true"></i> Sinh viên Đại học</p>
                <span class="code-badge">Mã SV: @Model.StudentId</span>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h2 class="card-title"><i class="bi bi-info-circle text-primary" aria-hidden="true"></i> Thông tin chi tiết</h2>
            </div>
            <div class="card-body py-2">
                <dl class="info-list">
                    <div>
                        <dt>Họ và tên</dt>
                        <dd>@Model.FullName</dd>
                    </div>
                    <div>
                        <dt>Email (tài khoản)</dt>
                        <dd>@Model.Email</dd>
                    </div>
                    <div>
                        <dt>Khoa</dt>
                        <dd>@Model.DepartmentName</dd>
                    </div>
                    <div>
                        <dt>Ngày sinh</dt>
                        <dd>@Model.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div>
                        <dt>Địa chỉ</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</div>
