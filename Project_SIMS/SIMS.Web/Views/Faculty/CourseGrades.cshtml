@model IEnumerable<SIMS.Application.DTOs.CourseGradeDto>

@{
    ViewData["Title"] = "Nhập điểm: " + ViewBag.CourseCode;
}

<div class="container-fluid px-4">
    <h1 class="mt-4 text-primary"><i class="bi bi-journal-check"></i> @ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Assigned Courses</a></li>
        <li class="breadcrumb-item active">@ViewBag.CourseTitle</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh sách sinh viên lớp @ViewBag.CourseCode</h5>
        </div>
        <div class="card-body">
            <form asp-action="SaveGrades" method="post">
                <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SV</th>
                                <th>Họ tên</th>
                                <th style="width: 200px;">Điểm tổng kết (Grade)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 0;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@item.StudentCode</span></td>
                                    <td class="fw-bold">@item.StudentName</td>
                                    <td>
                                        <input type="hidden" name="updates[@index].EnrollmentId" value="@item.EnrollmentId" />
                                        <input type="number" step="0.1" min="0" max="10" name="updates[@index].Grade" value="@item.Grade" class="form-control" placeholder="Nhập điểm..." />
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu điểm số</button>
                </div>
            </form>
        </div>
    </div>
</div>
