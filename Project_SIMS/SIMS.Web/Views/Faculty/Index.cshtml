@model IEnumerable<SIMS.Domain.Entities.Course>

@{
    ViewData["Title"] = "Môn phụ trách";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item active" aria-current="page">Môn phụ trách</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-easel-fill" aria-hidden="true"></i> @ViewData["Title"]</h1>
        <p class="page-subtitle">Các lớp bạn đang phụ trách. Chọn “Nhập điểm” để cập nhật điểm tổng kết.</p>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <h3>Chưa có lớp phụ trách</h3>
            <p>Hiện tại bạn chưa được phân công môn học nào.</p>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="search-box">
                <i class="bi bi-search" aria-hidden="true"></i>
                <label for="facultyCourseSearch" class="visually-hidden">Tìm môn phụ trách</label>
                <input id="facultyCourseSearch" type="search" class="form-control" placeholder="Tìm theo mã môn hoặc tên môn…"
                       data-table-filter="#facultyCourseTable" data-count-target="#facultyCourseCount" autocomplete="off" />
            </div>
            <span class="record-count" id="facultyCourseCount" aria-live="polite">@Model.Count() bản ghi</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-stack" id="facultyCourseTable">
                <caption class="visually-hidden">Danh sách lớp đang phụ trách</caption>
                <thead>
                    <tr>
                        <th scope="col">Mã môn</th>
                        <th scope="col">Tên môn</th>
                        <th scope="col" class="text-center">Số tín chỉ</th>
                        <th scope="col" class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr data-filter-row>
                            <td data-label="Mã môn"><span class="code-badge">@course.Code</span></td>
                            <td data-label="Tên môn" class="fw-semibold">@course.Title</td>
                            <td data-label="Số tín chỉ" class="text-center">@course.Credits</td>
                            <td class="text-end cell-actions">
                                <div class="row-actions">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="Xuất điểm môn @course.Code">
                                            <i class="bi bi-download" aria-hidden="true"></i> Xuất điểm
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-action="ExportGrades" asp-route-id="@course.Id" asp-route-format="csv"><i class="bi bi-filetype-csv text-primary" aria-hidden="true"></i> Xuất file CSV</a></li>
                                            <li><a class="dropdown-item" asp-action="ExportGrades" asp-route-id="@course.Id" asp-route-format="excel"><i class="bi bi-file-earmark-excel text-success" aria-hidden="true"></i> Xuất file Excel</a></li>
                                        </ul>
                                    </div>
                                    <a asp-action="CourseGrades" asp-route-id="@course.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i> Nhập điểm
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr data-no-result hidden>
                        <td colspan="4" class="empty-state-cell">
                            <div class="empty-state">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <h3>Không tìm thấy môn phù hợp</h3>
                                <p>Hãy thử từ khóa khác.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
