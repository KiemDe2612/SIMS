<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIMS Premium</title>
    
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Glassmorphism Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg glass-panel py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="bg-white rounded-circle p-2 shadow-sm me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fas fa-layer-group fs-5" style="color: var(--primary)"></i>
                    </div>
                    SIMS
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor" aria-controls="navbarColor" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars text-dark fs-4"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid flex-grow-1">
        <div class="row h-100">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 p-0 sidebar d-none d-md-block shadow-sm">
                <div class="py-4 px-3">
                    <a href="/" class="sidebar-link active">
                        <i class="bi bi-grid-1x2-fill"></i> Tổng quan
                    </a>
                    
                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="sb-sidenav-menu-heading">Quản trị viên</div>
                        <a href="/Students" class="sidebar-link">
                            <i class="bi bi-people-fill"></i> Quản lý Sinh viên
                        </a>
                        <a href="/Courses" class="sidebar-link">
                            <i class="bi bi-journal-bookmark-fill"></i> Quản lý Khóa học
                        </a>
                    }
                    
                    @if (User.IsInRole("Student"))
                    {
                        <div class="sb-sidenav-menu-heading">Góc Học Tập</div>
                        <a href="/StudentPortal/Profile" class="sidebar-link">
                            <i class="bi bi-person-badge-fill"></i> Hồ sơ cá nhân
                        </a>
                        <a href="/StudentPortal/Registration" class="sidebar-link">
                            <i class="bi bi-plus-square-fill"></i> Đăng ký Môn học
                        </a>
                        <a href="/StudentPortal/MyGrades" class="sidebar-link">
                            <i class="bi bi-bar-chart-fill"></i> Bảng điểm (CPA)
                        </a>
                    }
                    
                    @if (User.IsInRole("Faculty") || User.IsInRole("Administrator"))
                    {
                        <div class="sb-sidenav-menu-heading">Giảng viên</div>
                        <a href="/Faculty" class="sidebar-link">
                            <i class="bi bi-easel-fill"></i> Môn phụ trách & Điểm
                        </a>
                    }
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content bg-app">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Active Link Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var currentUrl = window.location.pathname;
            var links = document.querySelectorAll('.sidebar-link');
            
            links.forEach(function(link) {
                // Remove existing active class (except Dashboard if we are strictly on /)
                link.classList.remove('active');
                
                // Add active class if URL matches href
                var href = link.getAttribute('href');
                if(href === currentUrl || (href !== '/' && currentUrl.startsWith(href))) {
                    link.classList.add('active');
                }
                if(currentUrl === '/' && href === '/') {
                    link.classList.add('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
