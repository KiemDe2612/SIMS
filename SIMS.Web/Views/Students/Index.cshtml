@model IEnumerable<SIMS.Application.DTOs.StudentDto>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
}

<div>
    <div class="page-head">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>@Model.Count() sinh viên toàn trường</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportCsv" class="btn btn-outline-secondary">
                <i class="bi bi-download"></i> Export CSV
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm Sinh viên mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white pt-4 pb-0">
            <h5 class="mb-0">Danh sách Sinh viên toàn trường</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã SV</th>
                            <th>Họ và Tên</th>
                            <th>Email (Tài khoản)</th>
                            <th>Khoa</th>
                            <th>Ngày sinh</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.StudentId</span></td>
                                <td class="fw-bold">@item.FirstName @item.LastName</td>
                                <td><a href="mailto:@item.Email">@item.Email</a></td>
                                <td>@item.DepartmentName</td>
                                <td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này và tài khoản đăng nhập của họ?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
